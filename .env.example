# SGIM-CMCH - Variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores para tu entorno.
# NUNCA subas el archivo .env real al repositorio.

# Clave secreta de Django (genera una nueva en producción)
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura

# Modo debug: True en desarrollo, False en producción
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL
DB_NAME=sgim_cmch
DB_USER=sgim_user
DB_PASSWORD=cambia-esta-contraseña-segura
DB_HOST=localhost
DB_PORT=5432

# Zona horaria operativa (ajusta según la ubicación de la clínica)
TIME_ZONE=America/Bogota